{% extends "base.html.jinja" %}
{% block title %} — Parser LLM{% endblock %}

{% macro num(value, digits=3) %}{% if value is none %}—{% else %}{{ '%.*f'|format(digits, value) }}{% endif %}{% endmacro %}

{% macro delta(a, b) %}
  {% if a is none or b is none %}
    <span class="delta-nil">—</span>
  {% elif (b - a)|abs < 0.001 %}
    <span class="delta-nil">0.000</span>
  {% else %}
    <span class="{{ 'delta-pos' if b > a else 'delta-neg' }}">{{ '%+.3f'|format(b - a) }}</span>
  {% endif %}
{% endmacro %}

{% macro status_pill(value) %}
  {% if value == 'ok' %}<span class="pill pill-ok">ok</span>
  {% elif value == 'too_long' %}<span class="pill pill-skip">fuori contesto</span>
  {% elif value == 'error' %}<span class="pill pill-err">errore</span>
  {% else %}<span class="delta-nil">—</span>{% endif %}
{% endmacro %}

{% macro calls_label(run) -%}
  {%- if not run.calls %}<span class="delta-nil">&mdash;</span>
  {%- elif run.chunked_pages %}{{ run.calls }} per {{ run.ok }} pagine
    <span class="pill pill-skip" title="pagine lette a pezzi perché non entravano nel contesto">{{ run.chunked_pages }} a pezzi</span>
  {%- else %}{{ run.calls }} (una per pagina)
  {%- endif %}
{%- endmacro %}

{% macro cost_label(run) -%}
  {%- if not run.cost_eur and run.local_cost_eur %}&euro; {{ '%.7f'|format(run.local_cost_eur) }}
    <span class="delta-nil"
          title="Software gratuito: non c'è un importo fatturato. Questa è la spesa di chi lo esegue, su {{ '%.1f'|format(run.wall_seconds) }} s di lavoro: corrente € {{ '%.7f'|format(run.local_cost_electricity_eur) }} più usura del computer € {{ '%.7f'|format(run.local_cost_hardware_eur) }}. Non è confrontabile alla pari con una fattura, che contiene anche il margine del fornitore.">stimato</span>
  {%- elif not run.cost_eur %}<span class="delta-nil" title="nessun importo fatturato e nessuna durata registrata">&mdash;</span>
  {%- elif run.cost_is_aggregate %}&euro; {{ '%.4f'|format(run.cost_eur) }}
    <span class="delta-nil">(totale della run, senza dettaglio per chiamata)</span>
  {%- else %}&euro; {{ '%.4f'|format(run.cost_eur) }}
    <span class="delta-nil">(&euro; {{ '%.5f'|format(run.cost_eur / run.calls) }} a chiamata)</span>
  {%- endif %}
{%- endmacro %}



{% block content %}
<h1 class="page-title">Parser LLM contro Crawl4AI</h1>
<p class="page-sub">
  Le due pipeline ricevono lo <strong>stesso HTML</strong> e il risultato di entrambe viene
  misurato contro lo stesso gold standard, su tre assi: <strong>qualit&agrave;</strong> (F1),
  <strong>velocit&agrave;</strong> (secondi per pagina, da leggere solo fra locale e remoto)
  e <strong>risorse</strong>.
</p>

<div class="note-box">
  Questa pagina <strong>legge solo dal database</strong>: aprirla o ricaricarla non esegue
  nessun modello e non consuma credito. Le run si eseguono da riga di comando con
  <code>scripts/run_llm_eval.py</code> (OpenRouter solo con il flag esplicito
  <code>--openrouter</code>) e si caricano con <code>scripts/import_llm_run.py</code>.
</div>

{% if not runs %}
  <p class="page-sub">Nessuna run salvata. Importane una con
  <code>python scripts/import_llm_run.py output/&lt;file&gt;.json</code>.</p>
{% else %}

<div class="stats-table-wrap">
  <table class="stats-table table-dense">
    <thead>
      <tr>
        <th>Run</th>
        <th>Modello</th>
        <th>Condizione</th>
        <th>Pagine</th>
        <th>Prec.</th>
        <th>Rec.</th>
        <th>F1</th>
        <th>Excess</th>
        <th title="Secondi di orologio per pagina, non tempo di calcolo. Le run remote girano a piu' pagine in parallelo, quindi qui dentro c'e' anche la coda del fornitore.">Sec/pag *</th>
        <th>Risorse</th>
        <th>Costo</th>
      </tr>
    </thead>
    <tbody>
      {% for run in runs %}
      <tr>
        <td>
          <span class="run-name">
            <strong>{{ run.label }}</strong>
            <span>{{ run.created_at[:16] }}</span>
          </span>
        </td>
        <td>
          <span class="chip {{ 'chip-remote' if run.provider == 'openrouter' else 'chip-local' }}"
                title="provider: {{ run.provider }}">{{ run.model_name }}</span>
        </td>
        <td>{{ run.condition_name }}</td>
        <td>
          {{ run.ok }} ok
          {%- if run.too_long %} · <span class="pill pill-skip">{{ run.too_long }} fuori</span>{% endif %}
          {%- if run.errors %} · <span class="pill pill-err">{{ run.errors }} err</span>{% endif %}
        </td>
        <td>{{ num(run.precision) }}</td>
        <td>{{ num(run.recall) }}</td>
        <td><strong>{{ num(run.f1) }}</strong></td>
        <td>{{ num(run.excess_ratio) }}</td>
        <td>
          {{- '%.2f'|format(run.seconds) if run.seconds is not none and run.seconds < 10 else num(run.seconds, 0) -}}
          {%- if run.provider == 'openrouter' %}
            <span class="delta-nil"
                  title="Tempo di attesa su un servizio esterno, misurato in un dato momento: dipende da quanto era carico il fornitore, non dal modello.">&nbsp;*</span>
          {%- endif %}
        </td>
        <td>
          {% if run.input_tokens %}
            <span title="{% if run.skipped_tokens %}Escluse le pagine fuori contesto, mai inviate: {{ '{:,}'.format(run.skipped_tokens) }} token{% else %}Tutte le pagine sono state inviate{% endif %}">
              {{ '{:,}'.format(run.input_tokens) }} token
            </span>
          {% elif run.cpu_seconds %}
            <span title="Tempo di CPU sommato su tutte le pagine">{{ '%.1f'|format(run.cpu_seconds) }} s CPU</span>
          {% else %}<span class="delta-nil">—</span>{% endif %}
          {%- if run.chunked_pages %}
            <br><span class="pill pill-skip"
                      title="{{ run.chunked_pages }} pagine non entravano nel contesto e sono state lette a pezzi: {{ run.calls }} chiamate al modello per {{ run.ok }} pagine">
              {{ run.calls }} chiamate, {{ run.chunked_pages }} pagine a pezzi</span>
          {%- endif %}
        </td>
        <td>
          {% if run.cost_eur %}
            <span title="{% if run.cost_is_aggregate %}Totale della run letto dal saldo del provider: questa run e' precedente al conteggio per chiamata, quindi non c'e' una ripartizione per pagina{% else %}Fatturato dal provider, chiamata per chiamata. Media: EUR {{ '%.5f'|format(run.cost_eur / run.calls) }}{% endif %}">
              &euro; {{ '%.4f'|format(run.cost_eur) }}{% if run.cost_is_aggregate %}<span class="delta-nil"> tot.</span>{% endif %}
            </span>
          {% elif run.local_cost_eur %}
            <span title="Software gratuito: nessun importo fatturato. Spesa di chi lo esegue su {{ '%.1f'|format(run.wall_seconds) }} s: corrente € {{ '%.7f'|format(run.local_cost_electricity_eur) }} + usura del computer € {{ '%.7f'|format(run.local_cost_hardware_eur) }}">
              &euro; {{ '%.7f'|format(run.local_cost_eur) }}<br><span class="delta-nil">corrente e usura</span>
            </span>
          {% else %}<span class="delta-nil" title="nessun importo fatturato e nessuna durata registrata">&mdash;</span>{% endif %}
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
<p class="section-sub" style="margin-top:0.6rem">
  Le medie considerano solo le pagine effettivamente estratte; quelle fuori contesto sono
  contate a parte e i loro token non compaiono fra quelli inviati. Le due pipeline
  <strong>spendono risorse diverse e non sommabili</strong>: Crawl4AI consuma CPU locale e
  zero token, un LLM remoto consuma token e zero CPU locale.
</p>
<p class="section-sub">
  <strong>*</strong> Sulle run remote <strong>Sec/pag non misura il modello</strong>. &Egrave;
  tempo di orologio speso ad aspettare un servizio esterno, con pi&ugrave; pagine in volo
  insieme: lo stesso modello, sullo stesso fornitore e con la stessa quantizzazione, ha dato
  <strong>125 s</strong> e <strong>307 s</strong> a pagina in due giorni diversi. Serve a
  confrontare una pipeline remota con una locale, dove la distanza &egrave; di tre ordini di
  grandezza e nessun carico la spiega; <strong>non</strong> a mettere in fila due run remote.
</p>

<h2 class="section-title">Confronto fra due run</h2>
<form method="get" action="/llm-runs" class="form-row">
  <div class="field">
    <label for="left">Run A</label>
    <select id="left" name="left">
      {% for run in runs %}
      <option value="{{ run.id }}" {% if run.id == left %}selected{% endif %}>{{ run.label }}</option>
      {% endfor %}
    </select>
  </div>
  <div class="field">
    <label for="right">Run B</label>
    <select id="right" name="right">
      {% for run in runs %}
      <option value="{{ run.id }}" {% if run.id == right %}selected{% endif %}>{{ run.label }}</option>
      {% endfor %}
    </select>
  </div>
  <div class="field field-mode">
    <label>&nbsp;</label>
    <button type="submit" class="btn-primary">Confronta</button>
  </div>
</form>

{% if left == right %}
  <div class="note-box">Scegli due run diverse: confrontare una run con sé stessa non mostra nulla.</div>
{% elif not comparison %}
  <div class="note-box">Nessun dato da confrontare per queste due run.</div>
{% else %}

<p class="section-sub">
  <span class="pill" style="background:var(--bordeaux-soft);color:var(--bordeaux)">A</span>
  {{ left_run.label }} — {{ left_run.condition_name }}
  &nbsp;·&nbsp;
  <span class="pill" style="background:var(--gold-soft);color:#8a6d0b">B</span>
  {{ right_run.label }} — {{ right_run.condition_name }}
  <br>
  La colonna <em>Diff</em> è B meno A: <span class="delta-pos">verde</span> se B fa meglio,
  <span class="delta-neg">rosso</span> se fa meglio A.
</p>

<div class="stats-table-wrap" style="margin-bottom:1.25rem">
  <table class="stats-table table-dense">
    <thead>
      <tr><th>Asse</th>
          <th class="cmp-group-a">A — {{ left_run.label }}</th>
          <th class="cmp-group-b">B — {{ right_run.label }}</th>
          <th>Rapporto</th></tr>
    </thead>
    <tbody>
      <tr>
        <td class="domain-cell">Qualit&agrave; (F1 medio)</td>
        <td>{{ num(left_run.f1) }}</td>
        <td>{{ num(right_run.f1) }}</td>
        <td>{{ delta(left_run.f1, right_run.f1) }}</td>
      </tr>
      <tr>
        <td class="domain-cell">Copertura (pagine estratte)</td>
        <td>{{ left_run.ok }}/{{ left_run.ok + left_run.too_long + left_run.errors }}</td>
        <td>{{ right_run.ok }}/{{ right_run.ok + right_run.too_long + right_run.errors }}</td>
        <td>{% if right_run.ok == left_run.ok %}<span class="delta-nil">pari</span>
            {% else %}<span class="{{ 'delta-pos' if right_run.ok > left_run.ok else 'delta-neg' }}">{{ '%+d'|format(right_run.ok - left_run.ok) }}</span>{% endif %}</td>
      </tr>
      {% set entrambe_remote = left_run.provider == 'openrouter' and right_run.provider == 'openrouter' %}
      <tr>
        <td class="domain-cell">Velocit&agrave; (secondi per pagina)</td>
        <td>{{ '%.2f'|format(left_run.seconds) if left_run.seconds is not none }}</td>
        <td>{{ '%.2f'|format(right_run.seconds) if right_run.seconds is not none }}</td>
        <td>
          {% if entrambe_remote %}
            <!-- Niente rapporto fra due run remote: sarebbe un confronto fra
                 due fornitori in due momenti, non fra i due sistemi. -->
            <span class="delta-nil"
                  title="Due servizi esterni misurati in momenti diversi: la differenza dice quanto erano carichi, non quale sia piu' veloce.">non confrontabile</span>
          {% elif left_run.seconds and right_run.seconds %}
            {% set ratio = left_run.seconds / right_run.seconds %}
            <span class="{{ 'delta-pos' if ratio > 1 else 'delta-neg' }}">
              B {{ '%.0f'|format(ratio if ratio > 1 else 1 / ratio) }}&times; {{ "più veloce" if ratio > 1 else "più lenta" }}
            </span>
          {% else %}<span class="delta-nil">—</span>{% endif %}
        </td>
      </tr>
      {% if entrambe_remote %}
      <tr>
        <td colspan="4" class="section-sub" style="text-align:left;padding-top:0">
          Le due run girano su servizi esterni, a pagine parallele e in momenti diversi: i
          secondi misurano il carico del fornitore, non i due sistemi. Sulla velocit&agrave;
          il confronto che regge &egrave; contro Crawl4AI, che gira su questa macchina.
        </td>
      </tr>
      {% endif %}
      <tr>
        <td class="domain-cell">Risorse</td>
        <td>{% if left_run.input_tokens %}{{ '{:,}'.format(left_run.input_tokens) }} token{% elif left_run.cpu_seconds %}{{ '%.1f'|format(left_run.cpu_seconds) }} s CPU{% else %}—{% endif %}</td>
        <td>{% if right_run.input_tokens %}{{ '{:,}'.format(right_run.input_tokens) }} token{% elif right_run.cpu_seconds %}{{ '%.1f'|format(right_run.cpu_seconds) }} s CPU{% else %}—{% endif %}</td>
        <td><span class="delta-nil">grandezze diverse</span></td>
      </tr>
      <tr>
        <td class="domain-cell">Costo (&euro;)</td>
        <td>{{ cost_label(left_run) }}</td>
        <td>{{ cost_label(right_run) }}</td>
        <td>
          {% set sinistra = left_run.cost_eur or left_run.local_cost_eur %}
          {% set destra = right_run.cost_eur or right_run.local_cost_eur %}
          {% if sinistra and destra %}
            {% set ratio = sinistra / destra %}
            <span class="{{ 'delta-pos' if ratio > 1 else 'delta-neg' }}">B {{ '{:,.0f}'.format(ratio if ratio > 1 else 1 / ratio) }}&times; {{ "più economica" if ratio > 1 else "più cara" }}</span>
            {% if not (left_run.cost_eur and right_run.cost_eur) %}
              <br><span class="delta-nil" title="Una delle due cifre è una fattura, che include il margine del fornitore; l'altra è la spesa vera di chi esegue il software, senza margine perché non paga nessuno. Il rapporto dà l'ordine di grandezza, non una misura esatta.">fattura contro spesa propria: ordine di grandezza</span>
            {% endif %}
          {% else %}<span class="delta-nil">grandezze diverse</span>{% endif %}
        </td>
      </tr>
      <tr>
        <td class="domain-cell">Pagine per euro</td>
        <td>{% set c = left_run.cost_eur or left_run.local_cost_eur %}{% if c %}{{ '{:,.0f}'.format(left_run.ok / c) }}{% else %}&mdash;{% endif %}</td>
        <td>{% set c = right_run.cost_eur or right_run.local_cost_eur %}{% if c %}{{ '{:,.0f}'.format(right_run.ok / c) }}{% else %}&mdash;{% endif %}</td>
        <td><span class="delta-nil">quante pagine estrae un euro</span></td>
      </tr>
      <tr>
        <td class="domain-cell">Chiamate al modello</td>
        <td>{{ calls_label(left_run) }}</td>
        <td>{{ calls_label(right_run) }}</td>
        <td>
          {% if left_run.calls and right_run.calls and left_run.calls != right_run.calls %}
            <span class="{{ 'delta-pos' if right_run.calls < left_run.calls else 'delta-neg' }}">{{ '%+d'|format(right_run.calls - left_run.calls) }}</span>
          {% else %}<span class="delta-nil">—</span>{% endif %}
        </td>
      </tr>
    </tbody>
  </table>
</div>

{% if by_domain.left %}
{% set right_by_domain = {} %}
{% for row in by_domain.right %}{% set _ = right_by_domain.update({row.domain: row}) %}{% endfor %}
<div class="stats-table-wrap">
  <table class="stats-table table-dense">
    <thead>
      <tr>
        <th rowspan="2">Dominio</th>
        <th colspan="3" class="cmp-group-a">A — {{ left_run.condition_name }}</th>
        <th colspan="3" class="cmp-group-b">B — {{ right_run.condition_name }}</th>
        <th rowspan="2">Diff F1</th>
      </tr>
      <tr>
        <th class="cmp-group-a">Pagine</th><th class="cmp-group-a">F1</th><th class="cmp-group-a">Sec</th>
        <th class="cmp-group-b">Pagine</th><th class="cmp-group-b">F1</th><th class="cmp-group-b">Sec</th>
      </tr>
    </thead>
    <tbody>
      {% for row in by_domain.left %}
      {% set other = right_by_domain.get(row.domain) %}
      <tr>
        <td class="domain-cell">{{ row.domain }}</td>
        <td>{{ row.ok }}{% if row.too_long %} <span class="pill pill-skip">+{{ row.too_long }}</span>{% endif %}</td>
        <td>{{ num(row.f1) }}</td>
        <td>{{ '%.2f'|format(row.seconds) if row.seconds is not none else '—' }}</td>
        <td>{{ other.ok if other else '—' }}{% if other and other.too_long %} <span class="pill pill-skip">+{{ other.too_long }}</span>{% endif %}</td>
        <td>{{ num(other.f1 if other else none) }}</td>
        <td>{{ '%.2f'|format(other.seconds) if other and other.seconds is not none else '—' }}</td>
        <td>{{ delta(row.f1, other.f1 if other else none) }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endif %}

<h2 class="section-title">Pagina per pagina</h2>
<p class="section-sub">
  Ordinate per differenza di F1: in cima quelle dove le due condizioni divergono di più,
  comprese quelle che una sola delle due è riuscita a estrarre.
</p>
<div class="stats-table-wrap">
  <table class="stats-table table-dense">
    <thead>
      <tr>
        <th class="url-cell">Pagina</th>
        <th class="cmp-group-a">Stato A</th>
        <th class="cmp-group-a">F1 A</th>
        <th class="cmp-group-a">Token A</th>
        <th class="cmp-group-b">Stato B</th>
        <th class="cmp-group-b">F1 B</th>
        <th class="cmp-group-b">Token B</th>
        <th>Diff</th>
      </tr>
    </thead>
    <tbody>
      {% for row in comparison %}
      <tr>
        <td class="url-cell" title="{{ row.url }}">
          <code>{{ row.url|replace('https://','') }}</code>
          <a class="row-link" href="/llm-runs/text?left={{ left }}&amp;right={{ right }}&amp;url={{ row.url|urlencode }}">vedi i testi &rarr;</a>
          <span class="bar">
            <span class="bar-fill bar-a" style="width: {{ ((row.left_f1 or 0) * 100)|round(1) }}%"></span>
          </span>
          <span class="bar" style="margin-top:2px">
            <span class="bar-fill bar-b" style="width: {{ ((row.right_f1 or 0) * 100)|round(1) }}%"></span>
          </span>
        </td>
        <td>{{ status_pill(row.left_status) }}</td>
        <td>{{ num(row.left_f1) }}</td>
        <td>{{ '{:,}'.format(row.left_tokens) if row.left_tokens else '—' }}</td>
        <td>{{ status_pill(row.right_status) }}</td>
        <td>{{ num(row.right_f1) }}</td>
        <td>{{ '{:,}'.format(row.right_tokens) if row.right_tokens else '—' }}</td>
        <td>{{ delta(row.left_f1, row.right_f1) }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>

{% endif %}
{% endif %}
{% if self_check %}
{% set sc = self_check.summary %}
<h2 class="section-title">Autovalutazione del modello</h2>
<p class="section-sub">
  Al modello è stato ridato l'<strong>HTML grezzo</strong> insieme al Markdown che aveva prodotto,
  chiedendogli se l'estrazione fosse coerente con la pagina. Il gold standard non entra nella
  domanda: serve solo per misurare quanto il verdetto ci azzecca.
</p>

<div class="stats-table-wrap" style="margin-bottom:0.6rem">
  <table class="stats-table table-dense">
    <thead>
      <tr><th>Verdetto</th><th>Pagine</th><th>F1 medio</th></tr>
    </thead>
    <tbody>
      <tr><td class="domain-cell"><span class="pill pill-ok">coerente</span></td>
          <td>{{ sc.passed }}</td><td><strong>{{ num(sc.f1_passed) }}</strong></td></tr>
      <tr><td class="domain-cell"><span class="pill pill-skip">incoerente</span></td>
          <td>{{ sc.failed }}</td><td><strong>{{ num(sc.f1_failed) }}</strong></td></tr>
    </tbody>
  </table>
</div>
<p class="section-sub">
  Correlazione con l'F1 del gold standard: <strong>{{ num(sc.r_check) }}</strong> il verdetto
  s&igrave;/no del modello ({% if sc.cost_eur %}€ {{ '%.4f'|format(sc.cost_eur) }}{% else %}a pagamento{% endif %}){% if sc.r_coherence_cut is not none %},
  <strong>{{ num(sc.r_coherence_cut) }}</strong> lo stesso giudizio chiesto come punteggio 0-5 e
  riportato a s&igrave;/no alla soglia {{ sc.coherent_from }}{% endif %},
  <strong>{{ num(sc.r_grounded) }}</strong> l'ancoraggio, che si calcola in locale e non costa nulla.
</p>

{% if sc.scored %}
<p class="section-sub">
  La stessa domanda posta come punteggio d&agrave; in media
  <strong>{{ '%.2f'|format(sc.coherence_mean) }}/5</strong> su {{ sc.scored }} pagine. Non &egrave;
  una seconda misura: &egrave; la stessa, a una risoluzione diversa. Il booleano decide il verdetto
  perch&eacute; &egrave; la formulazione che &egrave; stata misurata, ma &egrave; anche quello che
  cambia da una run all'altra, mentre il punteggio no.
</p>
{% endif %}

{% if sc.quote_verdicts %}
{% set claimed = sc.quote_verdicts.values()|sum %}
<h3 class="section-title" style="font-size:1rem">Le citazioni, verificate dal codice</h3>
<p class="section-sub">
  Alla domanda &laquo;manca qualcosa?&raquo; il modello non risponde s&igrave; o no: deve
  <strong>citare</strong> i passi che secondo lui non sono arrivati nel Markdown. Ogni citazione
  viene poi cercata dal programma nella pagina e nell'estrazione, e solo
  <em>confermata</em> &egrave; un'omissione vera. Su questa run il modello ha prodotto
  <strong>{{ claimed }}</strong> citazioni e ne sono rimaste in piedi
  <strong>{{ sc.omissions }}</strong>: &egrave; la ragione per cui la completezza non viene
  dichiarata dal modello ma verificata dal codice.
</p>
<div class="stats-table-wrap" style="margin-bottom:1rem">
  <table class="stats-table table-dense">
    <thead>
      <tr><th style="text-align:left">Esito della citazione</th><th>Quante</th>
          <th style="text-align:left">Che cosa significa</th></tr>
    </thead>
    <tbody>
      <tr><td class="domain-cell"><span class="pill pill-skip">confermata</span></td>
          <td><strong>{{ sc.quote_verdicts.get('confermata', 0) }}</strong></td>
          <td style="text-align:left">Il passo &egrave; nella pagina e non nell'estrazione: omissione vera.</td></tr>
      <tr><td class="domain-cell"><span class="pill pill-ok">presente</span></td>
          <td><strong>{{ sc.quote_verdicts.get('presente', 0) }}</strong></td>
          <td style="text-align:left">Il passo era gi&agrave; nel Markdown: il modello segnala come mancante qualcosa che aveva estratto.</td></tr>
      <tr><td class="domain-cell"><span class="pill pill-skip">inventata</span></td>
          <td><strong>{{ sc.quote_verdicts.get('inventata', 0) }}</strong></td>
          <td style="text-align:left">Il passo non compare nella pagina: la citazione non &egrave; verbatim.</td></tr>
      <tr><td class="domain-cell"><span class="delta-nil">troppo corta</span></td>
          <td><strong>{{ sc.quote_verdicts.get('troppo corta', 0) }}</strong></td>
          <td style="text-align:left">Sotto i 25 caratteri: potrebbe combaciare per caso, non viene contata.</td></tr>
    </tbody>
  </table>
</div>
{% endif %}

<details style="margin-bottom:1.25rem">
<summary class="section-sub" style="cursor:pointer">Le {{ sc.checked }} pagine, una per una</summary>
<div class="stats-table-wrap" style="margin-top:0.6rem">
  <table class="stats-table table-dense">
    <thead>
      <tr><th>Pagina</th><th>F1</th><th>Ancoraggio</th><th>Verdetto</th>
          <th>Citazioni</th>
          <th style="text-align:left">Motivazione del modello</th></tr>
    </thead>
    <tbody>
      {% for page in self_check.pages %}
      <tr>
        <td class="domain-cell" title="{{ page.url }}">{{ page.url|truncate(58, true) }}</td>
        <td>{{ num(page.f1) }}</td>
        <td>{% if page.grounded is not none %}{{ '%.2f'|format(page.grounded) }}{% else %}&mdash;{% endif %}</td>
        <td>
          {%- if page.check_coherent %}<span class="pill pill-ok">coerente</span>
          {%- else %}<span class="pill pill-skip">incoerente</span>{% endif %}
          {%- if page.check_coherence is not none %}
            <span class="delta-nil">{{ page.check_coherence }}/5</span>{% endif %}
          {%- if page.check_fragments and page.check_fragments > 1 %}
            <span class="delta-nil">{{ page.check_fragments }} pezzi</span>{% endif %}
        </td>
        <td>
          {%- if page.check_quote_verdicts %}
            {%- for quote in page.check_quote_verdicts %}
            <div title="{{ quote.quote }}">
              {%- if quote.verdict == 'confermata' %}<span class="pill pill-skip">confermata</span>
              {%- elif quote.verdict == 'presente' %}<span class="pill pill-ok">presente</span>
              {%- else %}<span class="delta-nil">{{ quote.verdict }}</span>{% endif %}
            </div>
            {%- endfor %}
          {%- else %}&mdash;{% endif %}
        </td>
        <td style="text-align:left;font-family:inherit">
          <!-- La larghezza va sul div, non sulla cella: una cella ignora
               max-width e il testo allargava la tabella fuori pagina. -->
          <div style="width:32rem;font-size:0.82rem;line-height:1.4">
            {{ page.check_notes or '' }}
            {%- if page.check_coherence_evidence %}
            <!-- Il passo che il modello cita a sostegno del punteggio. -->
            <div style="margin-top:0.35rem;padding-left:0.6rem;border-left:2px solid var(--border, #d8d8d8);color:var(--muted, #666)">
              {{ page.check_coherence_evidence|truncate(300, true) }}
            </div>
            {%- endif %}
            {%- for quote in page.check_quote_verdicts %}
            <div style="margin-top:0.35rem;font-size:0.78rem">
              <em>{{ quote.verdict }}</em>: {{ quote.quote|truncate(160, true) }}
            </div>
            {%- endfor %}
          </div>
        </td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
</details>
{% endif %}

{% endblock %}
