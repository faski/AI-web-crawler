# Copia questo file in .env e riempi la chiave.
# .env e' gia' in .gitignore: la chiave non finisce nel repo.
# Docker Compose legge .env da solo, senza opzioni aggiuntive.

# --- provider ----------------------------------------------------------------
# Vale per TUTTO lo stack, interfaccia web compresa. Tienilo su "ollama":
# aprire una pagina non deve mai costare denaro. Gli script di ricerca
# attivano OpenRouter da soli, con il flag --openrouter.
LLM_PROVIDER=ollama

# --- modello locale ----------------------------------------------------------
# Guida insieme il pull di Ollama, l'healthcheck del container e il backend.
# qwen3.5:4b pesa 3,4 GB e sta nei 7,75 GB della VM Docker con la cache KV.
# Il 9b (6,6 GB) NON ci sta: servirebbe portare la VM a 12 GB.
OLLAMA_MODEL=qwen3.5:4b

# Senza questo Ollama usa 4096 token di contesto e taglia l'input IN SILENZIO.
OLLAMA_NUM_CTX=16384

# --- OpenRouter (usato solo con il flag --openrouter) ------------------------
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=qwen/qwen3.5-9b

# Blocca il provider a monte, cosi' la quantizzazione resta la stessa per
# tutta la run. Lasciato vuoto, OpenRouter sceglie da solo e lo stesso
# modello puo' arrivare da provider diversi.
OPENROUTER_PROVIDER=

# --- limiti ------------------------------------------------------------------
# L'inferenza remota e' veloce: 180s bastano. In locale su CPU servono ore.
LLM_TIMEOUT_SECONDS=180

# Budget di input del parser LLM. Deve stare sotto la finestra del modello:
# 262144 per la famiglia qwen3.5, 131072 per gemma-3 e qwen3.
LLM_PARSER_CONTEXT_TOKENS=262144

# Tetto sul Markdown generato. Le pagine Wikipedia piu' lunghe del gold
# standard arrivano a ~9000 token.
LLM_PARSER_MAX_TOKENS=16384

# Cosa fare con una pagina che non entra nel budget. A 0 viene segnalata come
# "troppo lunga" e saltata, che e' quello che hanno fatto tutti i run gia'
# registrati. A 1 viene divisa in pezzi che entrano, ogni pezzo viene letto a
# parte e le risposte vengono ricucite: costa una chiamata per pezzo.
LLM_PARSER_CHUNKING=0

# Quanto dividere il budget dei token per coprire l'errore della stima.
# 1.0 rimette il budget delle run gia' registrate.
LLM_TOKEN_SAFETY=1.15

# Permette alla pagina /parser di estrarre con il modello invece che con
# Crawl4AI. Spento: con LLM_PROVIDER=openrouter ogni clic e' una chiamata
# pagata, in locale e' una richiesta che resta appesa per minuti.
PARSE_WITH_LLM=0

# Cambio usato per riportare i costi in euro. I provider fatturano in dollari:
# l'importo in dollari e' il dato, quello in euro e' una conversione, e il
# cambio viene registrato insieme alla run cosi' un numero vecchio resta
# leggibile anche quando il cambio e' cambiato.
LLM_EUR_PER_USD=0.92
